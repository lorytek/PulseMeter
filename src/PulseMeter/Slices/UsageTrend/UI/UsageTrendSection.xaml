<UserControl x:Class="PulseMeter.Slices.UsageTrend.UI.UsageTrendSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PulseMeter.Slices.UsageTrend.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border x:Name="UsageTrendPanel"
            Margin="0,12,0,0"
            Padding="0"
            Style="{DynamicResource LightCardStyle}"
            AutomationProperties.Name="{Binding AccessibleSummary}">
        <StackPanel>
            <Grid Margin="16,10,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="UsageTrendHeading"
                           Text="Coding runway"
                           Foreground="#0F172A"
                           FontFamily="Segoe UI"
                           Focusable="True"
                           KeyboardNavigation.IsTabStop="False"
                           AutomationProperties.HeadingLevel="Level1"
                           FocusVisualStyle="{DynamicResource HeadingFocusVisualStyle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Height="34"
                            Margin="0,0,8,0"
                            Padding="2"
                            Background="#F8FAFC"
                            BorderBrush="#DCE3EC"
                            BorderThickness="1"
                            CornerRadius="9">
                        <ListBox ItemsSource="{Binding WindowOptions}"
                                 SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Usage limit window"
                                 AutomationProperties.HelpText="Choose either the 5-hour or 7-day chart. Only the selected chart is shown.">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    <Setter Property="MinWidth" Value="64" />
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Foreground" Value="#64748B" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Segment"
                                                        Padding="10,0"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0"
                                                        CornerRadius="7">
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               FontWeight="{TemplateBinding FontWeight}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Segment" Property="Background" Value="#EAF2FF" />
                                                        <Setter Property="Foreground" Value="#1F73FF" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Segment" Property="Background" Value="#F1F5F9" />
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsSelected" Value="True" />
                                                            <Condition Property="IsMouseOver" Value="True" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Segment" Property="Background" Value="#E4EEFF" />
                                                    </MultiTrigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Segment" Property="BorderBrush" Value="#1F73FF" />
                                                        <Setter TargetName="Segment" Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="Segment" Property="BorderBrush" Value="#1F73FF" />
                                                        <Setter TargetName="Segment" Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <ToggleButton Width="34"
                                  Height="34"
                                  Margin="0,0,6,0"
                                  IsChecked="{Binding ShowRange, Mode=TwoWay}"
                                  ToolTip="Show or hide the possible-limit window"
                                  AutomationProperties.Name="Show possible-limit window"
                                  AutomationProperties.HelpText="Shows the window when usage may reach the limit."
                                  Style="{DynamicResource LightIconToggleButtonStyle}">
                        <TextBlock Text="&#xE9D9;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" />
                    </ToggleButton>

                    <ToggleButton Width="34"
                                  Height="34"
                                  Margin="0,0,6,0"
                                  IsChecked="{Binding ShowProjection, Mode=TwoWay}"
                                  ToolTip="Show or hide the current-pace forecast"
                                  AutomationProperties.Name="Show current pace projection"
                                  Style="{DynamicResource LightIconToggleButtonStyle}">
                        <TextBlock Text="&#xE9D2;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" />
                    </ToggleButton>

                    <Button Width="34"
                            Height="34"
                            Command="{Binding ResetChartCommand}"
                            ToolTip="Reset chart view"
                            AutomationProperties.Name="Reset chart view"
                            Style="{DynamicResource CompactIconButtonStyle}">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChart}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Margin="16,10,16,0">
                    <TextBlock Text="{Binding RunwayHeadline}"
                               Foreground="#0F172A"
                               FontFamily="Segoe UI"
                               FontSize="28"
                               FontWeight="Bold"
                               LineHeight="34"
                               TextWrapping="Wrap" />

                    <WrapPanel Margin="0,7,0,0"
                               VerticalAlignment="Center">
                        <TextBlock Text="{Binding ForecastLeadText}"
                                   Foreground="#475569"
                                   FontSize="13" />
                        <TextBlock Margin="5,0,0,0"
                                   Text="{Binding ForecastWhenText}"
                                   Foreground="#16A34A"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <Border Margin="14,-2,0,-2"
                                Padding="8,3"
                                Background="#EFF6FF"
                                BorderBrush="#DBEAFE"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock Text="{Binding ConfidenceText}"
                                       Foreground="#1D4ED8"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <Grid Margin="16,16,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,14,0" HorizontalAlignment="Center">
                        <local:UsageMomentumGauge Width="160"
                                                  Height="58"
                                                  HorizontalAlignment="Center"
                                                  Value="{Binding MomentumGaugeValue}"
                                                  IsLearning="{Binding IsMomentumLearning}"
                                                  BaselineProgress="{Binding MomentumBaselineProgress}"
                                                  AutomationProperties.Name="{Binding MomentumAccessibleSummary}" />
                        <TextBlock Margin="0,1,0,0"
                                   Text="{Binding MomentumTitleText}"
                                   Foreground="#334155"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <StackPanel Margin="0,2,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MomentumValueText}"
                                       Foreground="{Binding MomentumValueBrush}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="17.5" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMomentumLearning}" Value="True">
                                                <Setter Property="FontSize" Value="15.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="MomentumPreviewInfo"
                                    Width="17"
                                    Height="17"
                                    Margin="5,0,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Help"
                                    Focusable="True"
                                    KeyboardNavigation.IsTabStop="True"
                                    Visibility="{Binding IsMomentumLearning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTipService.InitialShowDelay="250"
                                    ToolTipService.ShowDuration="15000"
                                    AutomationProperties.Name="Preview completed momentum gauge"
                                    AutomationProperties.HelpText="Focus or hover to see an example of the momentum gauge after the first activity-qualified baseline hour. Press Escape to dismiss it."
                                    GotKeyboardFocus="MomentumPreviewInfo_GotKeyboardFocus"
                                    LostKeyboardFocus="MomentumPreviewInfo_LostKeyboardFocus"
                                    PreviewKeyDown="MomentumPreviewInfo_PreviewKeyDown">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="InfoSurface"
                                                Background="#F8FAFC"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="InfoSurface" Property="Background" Value="#EFF6FF" />
                                                <Setter TargetName="InfoSurface" Property="BorderBrush" Value="#60A5FA" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="InfoSurface" Property="Background" Value="#EFF6FF" />
                                                <Setter TargetName="InfoSurface" Property="BorderBrush" Value="#2563EB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.ToolTip>
                                    <ToolTip x:Name="MomentumPreviewToolTip"
                                             Placement="Bottom"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0">
                                        <Border Width="228"
                                                Padding="12,10"
                                                Background="#FFFFFF"
                                                BorderBrush="#DCE3EC"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="Example after the first active hour"
                                                           Foreground="#0F172A"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Margin="0,2,0,2"
                                                           Text="After one completed active hour and 15 measured live minutes, this becomes a first-look momentum reading."
                                                           Foreground="#64748B"
                                                           FontSize="10.5"
                                                           LineHeight="14"
                                                           TextWrapping="Wrap" />
                                                <local:UsageMomentumGauge Width="136"
                                                                          Height="50"
                                                                          Margin="0,2,0,0"
                                                                          HorizontalAlignment="Center"
                                                                          IsLearning="False"
                                                                          Value="0.55"
                                                                          IsHitTestVisible="False"
                                                                          AutomationProperties.Name="Example measured momentum gauge" />
                                                <TextBlock Margin="0,1,0,0"
                                                           Text="Usage momentum"
                                                           Foreground="#334155"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center" />
                                                <TextBlock Margin="0,1,0,0"
                                                           Text="0.6%/h faster"
                                                           Foreground="#2563EB"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center" />
                                                <TextBlock Text="than recent active-hour baseline"
                                                           Foreground="#64748B"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ToolTip>
                                </Button.ToolTip>
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#475569"
                                           FontSize="9.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                        <TextBlock Margin="0,1,0,0"
                                   Text="{Binding MomentumStateText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,1,0,0"
                                   Text="{Binding MomentumBaselineText}"
                                   Foreground="#94A3B8"
                                   FontSize="10.5"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button x:Name="MomentumActivityInfo"
                                Margin="0,4,0,0"
                                Padding="5,2"
                                Background="Transparent"
                                BorderBrush="#DCE3EC"
                                BorderThickness="1"
                                Command="{Binding OpenMomentumDetailsCommand}"
                                Cursor="Hand"
                                AutomationProperties.Name="Activity-qualified momentum details"
                                AutomationProperties.HelpText="Shows which observed hours are included in usage momentum and lets you reset this quota window's learned baseline.">
                            <TextBlock Text="{Binding MomentumActivityStatusText}"
                                       Foreground="#64748B"
                                       FontSize="9.5" />
                        </Button>
                        <Popup x:Name="MomentumActivityPopup"
                               PlacementTarget="{Binding ElementName=MomentumActivityInfo}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding IsMomentumDetailsOpen, Mode=TwoWay}"
                               PreviewKeyDown="MomentumActivityPopup_PreviewKeyDown">
                            <Border Width="292"
                                    Margin="0,4,0,0"
                                    Padding="14,12"
                                    Background="#FFFFFF"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    AutomationProperties.Name="Activity-qualified momentum details">
                                <Grid>
                                    <StackPanel Visibility="{Binding IsMomentumDetailsContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Activity-qualified momentum"
                                                   Foreground="#0F172A"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{Binding MomentumActivityEvidenceText}"
                                                   Foreground="#334155"
                                                   FontSize="11" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding MomentumActivityCoverageText}"
                                                   Foreground="#64748B"
                                                   FontSize="10.5" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="{Binding MomentumMeaningText}"
                                                   Foreground="#64748B"
                                                   FontSize="10.5"
                                                   LineHeight="14"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="Confidence grows: First look at 1 hour; Early at 8 hours over 2 days; Established at 24 hours over 3 days."
                                                   Foreground="#475569"
                                                   FontSize="10.5"
                                                   LineHeight="14"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding MomentumScopeText}"
                                                   Foreground="#64748B"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding MomentumResetFeedback}"
                                                   Foreground="#2563EB"
                                                   FontSize="10.5"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasMomentumResetFeedback, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <Button Margin="0,10,0,0"
                                                Padding="8,5"
                                                HorizontalAlignment="Left"
                                                Background="#F8FAFC"
                                                BorderBrush="#CBD5E1"
                                                Command="{Binding RequestMomentumResetCommand}"
                                                Content="Reset learned baseline…"
                                                AutomationProperties.Name="Reset learned momentum baseline" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsMomentumResetConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Reset learned baseline?"
                                                   Foreground="#0F172A"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding MomentumResetConfirmationText}"
                                                   Foreground="#475569"
                                                   FontSize="10.5"
                                                   LineHeight="14"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="This clears PulseMeter’s learned momentum facts only. It does not change Codex history or account usage."
                                                   Foreground="#64748B"
                                                   FontSize="10.5"
                                                   LineHeight="14"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Button Padding="9,5"
                                                    Background="#2563EB"
                                                    Foreground="White"
                                                    BorderBrush="#2563EB"
                                                    Command="{Binding ConfirmMomentumResetCommand}"
                                                    Content="Reset" />
                                            <Button Margin="7,0,0,0"
                                                    Padding="9,5"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#CBD5E1"
                                                    Command="{Binding CancelMomentumResetCommand}"
                                                    Content="Cancel" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#E2E8F0" />

                    <StackPanel Grid.Column="2" Margin="18,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPaceText}"
                                   FontSize="24"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2563EB" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPaceBand}" Value="BelowSustainable">
                                            <Setter Property="Foreground" Value="#16A34A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentPaceBand}" Value="AboveSustainable">
                                            <Setter Property="Foreground" Value="#D97706" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentPaceBand}" Value="FarAboveSustainable">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0"
                                   Text="current pace"
                                   Foreground="#64748B"
                                   FontSize="11.5" />
                    </StackPanel>

                    <Border Grid.Column="3" Background="#E2E8F0" />

                    <StackPanel Grid.Column="4" Margin="18,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SustainablePaceText}"
                                   Foreground="#2563EB"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="sustainable"
                                   Foreground="#64748B"
                                   FontSize="11.5" />
                    </StackPanel>

                    <Border Grid.Column="5" Background="#E2E8F0" />

                    <StackPanel Grid.Column="6" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PaceComparisonText}"
                                   FontSize="22"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2563EB" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPaceBand}" Value="BelowSustainable">
                                            <Setter Property="Foreground" Value="#16A34A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentPaceBand}" Value="AboveSustainable">
                                            <Setter Property="Foreground" Value="#D97706" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentPaceBand}" Value="FarAboveSustainable">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentPaceBand}" Value="Unknown">
                                            <Setter Property="Foreground" Value="#64748B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding PaceComparisonLabel}"
                                   Foreground="#64748B"
                                   FontSize="11.5"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border Margin="16,11,16,0"
                        Padding="10,7"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F0FDF4" />
                            <Setter Property="BorderBrush" Value="#BBF7D0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PaceComparisonLabel}" Value="above sustainable pace">
                                    <Setter Property="Background" Value="#FFF7ED" />
                                    <Setter Property="BorderBrush" Value="#FED7AA" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PaceComparisonLabel}" Value="comparison unavailable">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding RecommendationText}"
                               Foreground="#475569"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>

                <Border Height="1"
                        Margin="16,14,16,0"
                        Background="#E2E8F0" />

                <WrapPanel Margin="16,9,16,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Usage chart legend">
                    <StackPanel Margin="0,0,14,0" Orientation="Horizontal">
                        <Line Width="18" Height="8" Y1="4" Y2="4" X2="18" Stroke="#2563EB" StrokeThickness="2.4" />
                        <TextBlock Margin="5,0,0,0" Text="Actual usage" Foreground="#475569" FontSize="10.5" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0" Orientation="Horizontal">
                        <Line Width="18" Height="8" Y1="4" Y2="4" X2="18" Stroke="#2563EB" StrokeThickness="1.8" StrokeDashArray="1,2" />
                        <TextBlock Margin="5,0,0,0" Text="Current forecast" Foreground="#475569" FontSize="10.5" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0" Orientation="Horizontal">
                        <Line Width="18" Height="8" Y1="4" Y2="4" X2="18" Stroke="#16A34A" StrokeThickness="1.6" StrokeDashArray="4,3" />
                        <TextBlock Margin="5,0,0,0" Text="Sustainable pace" Foreground="#475569" FontSize="10.5" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0" Orientation="Horizontal">
                        <Line Width="18" Height="8" Y1="4" Y2="4" X2="18" Stroke="#EA580C" StrokeThickness="1.4" StrokeDashArray="4,3" />
                        <TextBlock Margin="5,0,0,0" Text="Expected limit" Foreground="#475569" FontSize="10.5" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Line Width="18" Height="8" Y1="4" Y2="4" X2="18" Stroke="#16A34A" StrokeThickness="1.2" StrokeDashArray="4,3" />
                        <TextBlock Margin="5,0,0,0" Text="Reset" Foreground="#475569" FontSize="10.5" />
                    </StackPanel>
                </WrapPanel>

                <local:UsageTrendChart Height="380"
                                       Margin="8,4,8,8"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Model="{Binding ChartModel}"
                                       AutomationProperties.Name="{Binding AccessibleSummary}" />
            </StackPanel>

            <Border Margin="16,8,16,18"
                    Padding="14"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChart}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding EmptyStateText}"
                           Foreground="#64748B"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
