<UserControl x:Class="PulseMeter.Slices.BlockPlanner.UI.BlockPlannerSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border x:Name="BlockPlannerPanel"
            Margin="0,12,0,0"
            Padding="0"
            Style="{DynamicResource LightCardStyle}"
            AutomationProperties.Name="Block planner">
        <StackPanel>
            <Grid Margin="16,10,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Block planner"
                               Foreground="#0F172A"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0"
                               Text="Plan the next focused stretch at your current pace."
                               Foreground="#64748B"
                               FontSize="11.5" />
                </StackPanel>

                <Border Grid.Column="1"
                        Height="34"
                        Padding="2"
                        Background="#F8FAFC"
                        BorderBrush="#DCE3EC"
                        BorderThickness="1"
                        CornerRadius="9">
                    <ListBox ItemsSource="{Binding WindowOptions}"
                             SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Block planner limit window"
                             AutomationProperties.HelpText="Choose either the 5-hour or 7-day limit for this plan.">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                <Setter Property="MinWidth" Value="64" />
                                <Setter Property="Height" Value="28" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Segment" Padding="10,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="7">
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           FontWeight="{TemplateBinding FontWeight}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Segment" Property="Background" Value="#EAF2FF" />
                                                    <Setter Property="Foreground" Value="#1F73FF" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Segment" Property="Background" Value="#F1F5F9" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True" />
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Segment" Property="Background" Value="#E4EEFF" />
                                                </MultiTrigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Segment" Property="BorderBrush" Value="#1F73FF" />
                                                    <Setter TargetName="Segment" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="Segment" Property="BorderBrush" Value="#1F73FF" />
                                                    <Setter TargetName="Segment" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Grid>

            <Border Margin="16,6,16,16"
                    Padding="12,10"
                    Background="#F8FAFC"
                    BorderBrush="#DCE3EC"
                    BorderThickness="1"
                    CornerRadius="9"
                    AutomationProperties.Name="Waiting for limit data">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBlockAdvisor}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Waiting for limit data" Foreground="#0F172A" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0" Text="The planner will appear after PulseMeter receives a live 5h or 7d usage sample." Foreground="#64748B" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="16,6,16,16"
                    Padding="12,10"
                    Background="#F8FAFC"
                    BorderBrush="#DCE3EC"
                    BorderThickness="1"
                    CornerRadius="9"
                    AutomationProperties.Name="Plan your next block"
                    AutomationProperties.HelpText="Tests the selected limit at the current pace, not the cost of a task.">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBlockAdvisor}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Plan your next block" Foreground="#0F172A" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,8" Text="Tests the current pace, not task cost." Foreground="#64748B" FontSize="11.5" />
                    <Border Margin="0,0,0,9" Padding="9,7" Background="#FFFFFF" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="7"
                            AutomationProperties.Name="{Binding NextConstraintHeadline}"
                            AutomationProperties.HelpText="{Binding NextConstraintAccessibleSummary}">
                        <StackPanel>
                            <TextBlock Text="{Binding NextConstraintHeadline}" Foreground="#334155" FontSize="11.5" FontWeight="SemiBold"
                                       AutomationProperties.Name="{Binding NextConstraintHeadline}"
                                       AutomationProperties.HelpText="{Binding NextConstraintAccessibleSummary}" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding NextConstraintDetail}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding BlockOptions}"
                                  AutomationProperties.Name="Next block duration choices"
                                  AutomationProperties.HelpText="Choose a duration to assess against the current selected limit. The selected duration is announced as selected.">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelpText}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Margin="0,0,6,7" Padding="10,5" GroupName="NextBlockDuration"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.SelectBlockDurationCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                             CommandParameter="{Binding DurationMinutes}"
                                             AutomationProperties.Name="{Binding AutomationName}"
                                             AutomationProperties.HelpText="{Binding AutomationHelpText}">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#CBD5E1" />
                                            <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#475569" />
                                            <Setter Property="FontSize" Value="11.5" /><Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Segment" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="#F1F5F9" /></Trigger>
                                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="#EAF2FF" /><Setter TargetName="Segment" Property="BorderBrush" Value="#93C5FD" /><Setter Property="Foreground" Value="#1F73FF" /></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="#1F73FF" /><Setter TargetName="Segment" Property="BorderThickness" Value="2" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate></Setter.Value></Setter>
                                        </Style>
                                    </RadioButton.Style>
                                    <TextBlock Text="{Binding Label}" />
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding BlockAdvisorState}" FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#2563EB" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Likely fits"><Setter Property="Foreground" Value="#16A34A" /></DataTrigger>
                                <DataTrigger Binding="{Binding BlockAdvisorState}" Value="May be interrupted"><Setter Property="Foreground" Value="#D97706" /></DataTrigger>
                                <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Unlikely to fit"><Setter Property="Foreground" Value="#DC2626" /></DataTrigger>
                                <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Wait for reset"><Setter Property="Foreground" Value="#D97706" /></DataTrigger>
                            </Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Text="{Binding BlockAdvisorDetail}" Foreground="#475569" FontSize="11.5" TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding BlockAdvisorAccessibleSummary}" />
                    <Border Margin="0,10,0,0" Padding="9,8" Background="#FFFFFF" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="7"
                            AutomationProperties.Name="Recovery watch" AutomationProperties.HelpText="{Binding RecoveryWatchAccessibleSummary}">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding CanManageRecoveryWatch}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,10,0" Text="{Binding RecoveryWatchText}" Foreground="#475569" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Padding="9,5" Background="#EAF2FF" BorderBrush="#93C5FD" BorderThickness="1" Command="{Binding ToggleRecoveryWatchCommand}" Content="{Binding RecoveryWatchActionText}" Foreground="#1F73FF" FontSize="11" FontWeight="SemiBold" IsEnabled="{Binding CanManageRecoveryWatch}" AutomationProperties.Name="{Binding RecoveryWatchActionText}" AutomationProperties.HelpText="{Binding RecoveryWatchAccessibleSummary}">
                                <Button.Style><Style TargetType="Button"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="RecoveryWatchButton" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RecoveryWatchButton" Property="Background" Value="#DBEAFE" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RecoveryWatchButton" Property="BorderBrush" Value="#1F73FF" /><Setter TargetName="RecoveryWatchButton" Property="BorderThickness" Value="2" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#94A3B8" /><Setter TargetName="RecoveryWatchButton" Property="Background" Value="#F8FAFC" /><Setter TargetName="RecoveryWatchButton" Property="BorderBrush" Value="#E2E8F0" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                    <Border Margin="0,8,0,0" Padding="9,7" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="7">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasRecoveryConfirmation}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock x:Name="RecoveryConfirmationTextBlock" Text="{Binding RecoveryConfirmationText, NotifyOnTargetUpdated=True}" TargetUpdated="RecoveryConfirmationTextBlock_TargetUpdated" Foreground="#15803D" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="RecoveryConfirmation" AutomationProperties.Name="Recovery confirmation" AutomationProperties.HelpText="{Binding RecoveryConfirmationText}" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
