<UserControl x:Class="PulseMeter.Slices.BlockPlanner.UI.BlockPlannerSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border x:Name="BlockPlannerPanel"
            Margin="0,12,0,0"
            Padding="0"
            Style="{DynamicResource LightCardStyle}"
            AutomationProperties.Name="Block planner">
        <StackPanel>
            <Grid Margin="16,12,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="BlockPlannerHeading"
                           VerticalAlignment="Center"
                           Text="Block planner"
                           Foreground="#0F172A"
                           FontFamily="Segoe UI"
                           Focusable="True"
                           KeyboardNavigation.IsTabStop="False"
                           AutomationProperties.HeadingLevel="Level1"
                           FocusVisualStyle="{DynamicResource HeadingFocusVisualStyle}"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <Border x:Name="BlockWindowSelectorBorder"
                        Grid.Column="1"
                        MinWidth="108"
                        Height="34"
                        CornerRadius="9">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="BorderBrush" Value="#DCE3EC" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Background" Value="#EEF5FF" />
                                    <Setter Property="BorderBrush" Value="#1F73FF" />
                                </Trigger>
                                <DataTrigger Binding="{Binding WindowOptions.Count}" Value="1">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#DCE3EC" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ComboBox ItemsSource="{Binding WindowOptions}"
                              SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              Padding="9,3"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#1F73FF"
                              FontSize="12"
                              FontWeight="SemiBold"
                              HorizontalContentAlignment="Center"
                              FocusVisualStyle="{x:Null}"
                              AutomationProperties.Name="Block planner limit window"
                              AutomationProperties.HelpText="Choose either the 5-hour or 7-day limit for this plan.">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Focusable" Value="True" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Items.Count}" Value="1">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="Foreground" Value="#334155" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="ItemChrome"
                                                    Margin="3,1"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent"
                                                    CornerRadius="6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemChrome" Property="Background" Value="#F1F5F9" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemChrome" Property="Background" Value="#EAF2FF" />
                                                    <Setter Property="Foreground" Value="#1F73FF" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Resources>
                        <ComboBox.Template>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid Background="Transparent">
                                    <ToggleButton x:Name="DropDownToggle"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <Grid x:Name="SelectorContentGrid" Margin="10,0,8,0" IsHitTestVisible="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="ArrowColumn" Width="16" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                        <TextBlock x:Name="DropDownArrow"
                                                   Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Text="&#xE70D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="9"
                                                   Foreground="#64748B" />
                                    </Grid>

                                    <Popup x:Name="PART_Popup"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           IsOpen="{TemplateBinding IsDropDownOpen}"
                                           Placement="Bottom"
                                           PopupAnimation="Fade">
                                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                Margin="0,4,0,0"
                                                Padding="2"
                                                Background="#FFFFFF"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12"
                                                                  Direction="270"
                                                                  Opacity="0.14"
                                                                  ShadowDepth="3"
                                                                  Color="#334155" />
                                            </Border.Effect>
                                            <ScrollViewer MaxHeight="180"
                                                          CanContentScroll="True"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsDropDownOpen" Value="True">
                                        <Setter TargetName="DropDownArrow" Property="Text" Value="&#xE70E;" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding WindowOptions.Count}" Value="1">
                                        <Setter TargetName="DropDownToggle" Property="IsEnabled" Value="False" />
                                        <Setter TargetName="DropDownArrow" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ArrowColumn" Property="Width" Value="0" />
                                        <Setter TargetName="SelectorContentGrid" Property="Margin" Value="10,0" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ComboBox.Template>
                    </ComboBox>
                </Border>
            </Grid>

            <Border Margin="16,4,16,16"
                    Padding="12,10"
                    Background="#F8FAFC"
                    BorderBrush="#DCE3EC"
                    BorderThickness="1"
                    CornerRadius="9"
                    AutomationProperties.Name="Waiting for limit data">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBlockAdvisor}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Waiting for limit data" Foreground="#0F172A" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="The planner will appear after PulseMeter receives a live 5h or 7d usage sample."
                               Foreground="#64748B"
                               FontSize="11.5"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="16,4,16,16"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="Plan your next block"
                    AutomationProperties.HelpText="{Binding BlockAdvisorAccessibleSummary}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBlockAdvisor}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="BlockVerdictIcon"
                                Width="36"
                                Height="36"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                CornerRadius="18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EAF2FF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Likely fits">
                                            <Setter Property="Background" Value="#DCFCE7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BlockAdvisorState}" Value="May be interrupted">
                                            <Setter Property="Background" Value="#FFF7ED" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Unlikely to fit">
                                            <Setter Property="Background" Value="#FEF2F2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Wait for reset">
                                            <Setter Property="Background" Value="#FFF7ED" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE946;" />
                                        <Setter Property="Foreground" Value="#1F73FF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Likely fits">
                                                <Setter Property="Text" Value="&#xE73E;" />
                                                <Setter Property="Foreground" Value="#16A34A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BlockAdvisorState}" Value="May be interrupted">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="#D97706" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Unlikely to fit">
                                                <Setter Property="Text" Value="&#xEA39;" />
                                                <Setter Property="Foreground" Value="#DC2626" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Wait for reset">
                                                <Setter Property="Text" Value="&#xE823;" />
                                                <Setter Property="Foreground" Value="#D97706" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Margin="0,0,5,0"
                                       Text="{Binding BlockAdvisorSubjectText}"
                                       Foreground="#0F172A"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BlockAdvisorVerdictText}"
                                       FontSize="20"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2563EB" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Likely fits">
                                                <Setter Property="Foreground" Value="#16A34A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BlockAdvisorState}" Value="May be interrupted">
                                                <Setter Property="Foreground" Value="#D97706" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Unlikely to fit">
                                                <Setter Property="Foreground" Value="#DC2626" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BlockAdvisorState}" Value="Wait for reset">
                                                <Setter Property="Foreground" Value="#D97706" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </WrapPanel>
                    </Grid>

                    <Grid Margin="0,15,0,0"
                          AutomationProperties.Name="Block timing"
                          AutomationProperties.HelpText="{Binding BlockAdvisorTimelineAccessibleSummary}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Now" Foreground="#334155" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding BlockAdvisorNowText}" Foreground="#64748B" FontSize="10.5" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Block ends" Foreground="#334155" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding BlockAdvisorEndsAtText}" Foreground="#64748B" FontSize="10.5" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BlockAdvisorConstraintLabel}" Foreground="#334155" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Right" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding BlockAdvisorConstraintTimeText}" Foreground="#64748B" FontSize="10.5" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="4,5,4,0">
                            <Line Margin="0,10,0,10"
                                  X1="0"
                                  Y1="0"
                                  X2="1"
                                  Y2="0"
                                  Stretch="Fill"
                                  Stroke="#94A3B8"
                                  StrokeThickness="2"
                                  StrokeDashArray="3,3" />
                            <ProgressBar Height="14"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding BlockAdvisorTimelineProgressPercent, Mode=OneWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#1F73FF">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid x:Name="PART_Track" ClipToBounds="False">
                                            <Border x:Name="PART_Indicator"
                                                    Height="3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{TemplateBinding Foreground}"
                                                    CornerRadius="1.5">
                                                <Border Width="14"
                                                        Height="14"
                                                        Margin="0,-6,-7,-6"
                                                        HorizontalAlignment="Right"
                                                        Background="#1F73FF"
                                                        BorderBrush="#DBEAFE"
                                                        BorderThickness="3"
                                                        CornerRadius="7" />
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#64748B" BorderThickness="2" CornerRadius="6" />
                            <Border x:Name="BlockPlannerConstraintEndpoint"
                                    Width="12"
                                    Height="12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#FFFFFF"
                                    BorderBrush="#64748B"
                                    BorderThickness="2"
                                    CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BlockAdvisorTimelineProgressPercent}" Value="100">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border Margin="0,13,0,0"
                            Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="9">
                        <ItemsControl ItemsSource="{Binding BlockOptions}"
                                      AutomationProperties.Name="Next block duration choices"
                                      AutomationProperties.HelpText="Choose a duration to assess against the current selected limit. The selected duration is announced as selected.">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelpText}" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Height="40"
                                                 Padding="10,5"
                                                 GroupName="NextBlockDuration"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectBlockDurationCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                 CommandParameter="{Binding DurationMinutes}"
                                                 AutomationProperties.Name="{Binding AutomationName}"
                                                 AutomationProperties.HelpText="{Binding AutomationHelpText}">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                                                <Setter Property="Foreground" Value="#334155" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="Segment"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="7">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Segment" Property="Background" Value="#F1F5F9" />
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Segment" Property="Background" Value="#1F73FF" />
                                                                    <Setter TargetName="Segment" Property="BorderBrush" Value="#1F73FF" />
                                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="Segment" Property="BorderBrush" Value="#0F172A" />
                                                                    <Setter TargetName="Segment" Property="BorderThickness" Value="2" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                    <Setter TargetName="Segment" Property="BorderBrush" Value="#0F172A" />
                                                                    <Setter TargetName="Segment" Property="BorderThickness" Value="2" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                        <TextBlock Text="{Binding Label}" />
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="0,12,0,0"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.35*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,7,0" Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1F73FF" />
                                <TextBlock Text="{Binding BlockAdvisorConfidenceText}" Foreground="#334155" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Margin="10,0" Background="#E2E8F0" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding NextConstraintHeadline}"
                                        AutomationProperties.HelpText="{Binding NextConstraintAccessibleSummary}">
                                <TextBlock Margin="0,0,7,0" Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1F73FF" />
                                <TextBlock Text="{Binding NextConstraintHeadline}"
                                           ToolTip="{Binding NextConstraintDetail}"
                                           Foreground="#334155"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.Name="{Binding NextConstraintHeadline}"
                                           AutomationProperties.HelpText="{Binding NextConstraintAccessibleSummary}" />
                            </StackPanel>
                            <Border Grid.Column="3" Width="1" Margin="10,0" Background="#E2E8F0" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,7,0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#64748B" />
                                <TextBlock Text="Based on current pace, not task cost."
                                           Foreground="#64748B"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding BlockAdvisorDetail}"
                               Foreground="#475569"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding BlockAdvisorAccessibleSummary}" />

                    <Border Margin="0,10,0,0"
                            Padding="9,8"
                            Background="#FFFFFF"
                            BorderBrush="#DCE3EC"
                            BorderThickness="1"
                            CornerRadius="7"
                            AutomationProperties.Name="Recovery watch"
                            AutomationProperties.HelpText="{Binding RecoveryWatchAccessibleSummary}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanManageRecoveryWatch}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,10,0" Text="{Binding RecoveryWatchText}" Foreground="#475569" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Padding="9,5"
                                    Background="#EAF2FF"
                                    BorderBrush="#93C5FD"
                                    BorderThickness="1"
                                    Command="{Binding ToggleRecoveryWatchCommand}"
                                    Content="{Binding RecoveryWatchActionText}"
                                    Foreground="#1F73FF"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    IsEnabled="{Binding CanManageRecoveryWatch}"
                                    AutomationProperties.Name="{Binding RecoveryWatchActionText}"
                                    AutomationProperties.HelpText="{Binding RecoveryWatchAccessibleSummary}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RecoveryWatchButton" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RecoveryWatchButton" Property="Background" Value="#DBEAFE" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="RecoveryWatchButton" Property="BorderBrush" Value="#1F73FF" />
                                                            <Setter TargetName="RecoveryWatchButton" Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#94A3B8" />
                                                            <Setter TargetName="RecoveryWatchButton" Property="Background" Value="#F8FAFC" />
                                                            <Setter TargetName="RecoveryWatchButton" Property="BorderBrush" Value="#E2E8F0" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Margin="0,8,0,0" Padding="9,7" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="7">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecoveryConfirmation}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="RecoveryConfirmationTextBlock"
                                   Text="{Binding RecoveryConfirmationText, NotifyOnTargetUpdated=True}"
                                   TargetUpdated="RecoveryConfirmationTextBlock_TargetUpdated"
                                   Foreground="#15803D"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="RecoveryConfirmation"
                                   AutomationProperties.Name="Recovery confirmation"
                                   AutomationProperties.HelpText="{Binding RecoveryConfirmationText}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
