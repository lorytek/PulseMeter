<UserControl x:Class="PulseMeter.Slices.ReturnNote.UI.ReturnNoteSection"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border Margin="0,12,0,0"
            Padding="16"
            Style="{DynamicResource LightCardStyle}"
            AutomationProperties.Name="Return notes">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RETURN NOTES"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827" />
                        <Border Margin="10,0,0,0"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                Background="#EFF6FF"
                                CornerRadius="8">
                            <TextBlock Text="SAVED LOCALLY"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#2563EB" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0"
                               Text="Keep several handoff notes ready across app restarts."
                               Foreground="#4B5563"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding NoteCountText}"
                           Foreground="#6B7280"
                           Visibility="{Binding HasNotes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Grid.Column="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding AddNoteCommand}"
                        Style="{DynamicResource LightButtonStyle}"
                        AutomationProperties.Name="Add note"
                        Visibility="{Binding IsNotEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <AccessText Text="+ _Add note" />
                </Button>
            </Grid>

            <Border Margin="0,14,0,0"
                    Padding="14"
                    Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    FocusManager.IsFocusScope="True"
                    FocusManager.FocusedElement="{Binding ElementName=ForTextBox}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Margin="0,12,0,5"
                               Text="Project or task"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#374151" />
                    <TextBox x:Name="ForTextBox"
                             Text="{Binding ForText, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="160"
                             Style="{DynamicResource LightTextBoxStyle}"
                             AutomationProperties.Name="Project or task"
                             AutomationProperties.HelpText="A short label such as the project, task, or decision this note belongs to." />
                    <TextBlock Margin="0,12,0,5"
                               Text="Next step"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#374151" />
                    <TextBox x:Name="NextStepTextBox"
                             Text="{Binding NextStep, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="480"
                             Style="{DynamicResource LightMultilineTextBoxStyle}"
                             AutomationProperties.Name="Next step"
                             AutomationProperties.HelpText="Enter the next action or handoff. Multiple lines are supported." />
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Protected for this Windows user and stored locally. Avoid secrets or customer data."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal">
                            <Button Command="{Binding SaveCommand}"
                                    Style="{DynamicResource LightPrimaryButtonStyle}"
                                    AutomationProperties.Name="Save return note">
                                <AccessText Text="_Save note" />
                            </Button>
                            <Button Margin="8,0,0,0"
                                    Command="{Binding CancelCommand}"
                                    Style="{DynamicResource LightButtonStyle}"
                                    AutomationProperties.Name="Cancel editing return note">
                                <AccessText Text="_Cancel" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="14"
                    Background="#F9FAFB"
                    CornerRadius="8"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Text="No return notes yet"
                               FontWeight="SemiBold"
                               Foreground="#374151" />
                    <TextBlock Margin="0,3,0,0"
                               Text="Add a next step you do not want to lose when switching tasks."
                               Foreground="#6B7280"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsControl Margin="0,12,0,0"
                          ItemsSource="{Binding Notes}"
                          Visibility="{Binding HasNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="13"
                                Background="#FFFFFF"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding For}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1"
                                                Margin="14,0,0,0"
                                                Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource LightButtonStyle}"
                                                AutomationProperties.Name="Edit return note"
                                                Content="Edit" />
                                        <Button Margin="6,0,0,0"
                                                Command="{Binding DataContext.CopyNextStepCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource LightButtonStyle}"
                                                AutomationProperties.Name="Copy next step"
                                                AutomationProperties.HelpText="Copies only this note's next step. Clipboard history or sync may retain it."
                                                Content="Copy" />
                                        <Button Margin="6,0,0,0"
                                                Command="{Binding DataContext.RemoveNoteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource LightButtonStyle}"
                                                AutomationProperties.Name="Remove return note"
                                                Content="Remove" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding NextStep}"
                                           Foreground="#374151"
                                           TextWrapping="Wrap" />
                                <Border Margin="0,10,0,0"
                                        Padding="10"
                                        Background="#FFF7ED"
                                        CornerRadius="7"
                                        Visibility="{Binding IsPendingRemoval, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Remove this saved note?"
                                                   Foreground="#9A3412"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.ConfirmRemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource LightButtonStyle}"
                                                    AutomationProperties.Name="Confirm remove return note"
                                                    Content="Remove" />
                                            <Button Margin="6,0,0,0"
                                                    Command="{Binding DataContext.CancelRemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource LightButtonStyle}"
                                                    AutomationProperties.Name="Cancel removing return note"
                                                    Content="Keep" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,8,0,0"
                       Text="{Binding StatusText}"
                       Foreground="#374151"
                       AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Border>
</UserControl>
