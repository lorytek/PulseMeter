<Window x:Class="PulseMeter.Slices.SupportSnapshot.UI.SupportSnapshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="PulseMeter support snapshot"
        Width="680" MaxHeight="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FFFFFF" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="PulseMeter support snapshot" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,10,0,12" TextWrapping="Wrap" Foreground="#4B5563"
                   Text="This preview diagnoses PulseMeter's local reading only—not Codex, account, or billing health. Nothing is copied until you choose Copy preview. Clipboard history or sync may expose copied text; PulseMeter does not send it." />
        <TextBox Grid.Row="2" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 MinHeight="210" Padding="10" Background="#F9FAFB" BorderBrush="#D1D5DB"
                 automation:AutomationProperties.Name="Support snapshot JSON preview" />
        <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#4B5563" Text="{Binding CopyFeedback}" automation:AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,6" Content="Copy preview" Command="{Binding CopyPreviewCommand}" automation:AutomationProperties.Name="Copy support snapshot preview" IsDefault="True" />
            <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,6" Content="Close" Click="Close_Click" automation:AutomationProperties.Name="Close support snapshot preview" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
